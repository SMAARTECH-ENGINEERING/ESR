{
  "expo": {
    "name": "Aquasence",
    "slug": "aquasence",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.esr.aquasence"
    },
    "android": {
      "package": "com.esr.aquasence"
    },
    "web": {
      "favicon": "./assets/image.png"
    },
    "plugins": ["expo-secure-store", "@react-native-community/datetimepicker"]
  }
}
