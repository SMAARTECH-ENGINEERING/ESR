# ========================
# APPLICATION
# ========================
NODE_ENV=development
PORT=5000

# ========================
# MONGODB ATLAS
# ========================
MONGODB_URI=mmongodb://localhost:27017/esr-test-local

# ========================
# JWT AUTHENTICATION
# ========================
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_change_in_production
JWT_EXPIRE=7d

# ========================
# CORS
# ========================
CORS_ORIGIN=http://localhost:3000

# ========================
# RATE LIMITING
# ========================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ========================
# IOT DEVICE AUTHENTICATION
# ========================
# Shared secret key sent by IoT devices in X-Device-Secret header
IOT_DEVICE_SECRET=your_iot_device_shared_secret_key_change_in_production

# ========================
# DATA RETENTION
# ========================
# Days of IoT history kept (live_data readings, report_data, iwcrcm_transmissions).
# Applied to MongoDB TTL indexes at startup + daily cleanup job.
# Does NOT affect users, tanks or configuration.
DATA_RETENTION_DAYS=120

# ========================
# IWCRCM INTEGRATION (Industrial Water Consumption and Revenue Monitoring)
# See IWCRCM_INTEGRATION.md. Never commit real keys/secrets.
# ========================
IWCRCM_ENABLED=false
IWCRCM_AUTH_URL=https://api.industrialwaterod.nic.in/auth
IWCRCM_DATA_URL=https://api.industrialwaterod.nic.in/main
IWCRCM_SEND_INTERVAL_MINUTES=60
IWCRCM_AUTH_REFRESH_BUFFER_MINUTES=10

# RSA public key issued by IWCRCM (REQUIRED FROM IWCRCM API PROVIDER).
# Either paste the PEM on one line with literal \n, or point to a file.
IWCRCM_PUBLIC_KEY=
# IWCRCM_PUBLIC_KEY_FILE=./secrets/iwcrcm_public.pem
# node-rsa key format ('' = auto-detect PEM) and padding scheme (node-rsa default pkcs1_oaep)
IWCRCM_PUBLIC_KEY_FORMAT=
IWCRCM_RSA_ENCRYPTION_SCHEME=pkcs1_oaep

# Path to a JS module exporting createResponseCode({ deviceId, challengeKey, expire, keyType }).
# The scramble algorithm is NOT in the PDF — REQUIRED FROM IWCRCM API PROVIDER.
IWCRCM_SCRAMBLE_MODULE=

# Encrypts cached 24h auth keys in MongoDB (min 32 chars, random)
IWCRCM_CREDENTIAL_SECRET=replace_with_a_random_string_of_at_least_32_characters

# Optional tuning (defaults shown)
# IWCRCM_AUTH_KEY_TTL_HOURS=24
# IWCRCM_CHALLENGE_TTL_SECONDS=120
# IWCRCM_REQUEST_TIMEOUT_MS=15000
# IWCRCM_HTTP_RETRIES=2
# IWCRCM_HTTP_RETRY_BASE_MS=1000
# IWCRCM_MAX_ATTEMPTS=10
# IWCRCM_RETRY_BACKOFF_MINUTES=5
# IWCRCM_RETRY_BACKOFF_MAX_MINUTES=360
# IWCRCM_BATCH_SIZE=50
# Unit conversion for flow (local L/min) and qty (local litres) — units REQUIRED FROM IWCRCM
# IWCRCM_FLOW_MULTIPLIER=1
# IWCRCM_QTY_MULTIPLIER=1
# IWCRCM_ROLL_VALUE=0

# ========================
# LOGGING
# ========================
LOG_LEVEL=info
LOG_DIR=logs

# ========================
# REDIS (Optional - for Socket.IO horizontal scaling)
# ========================
# REDIS_URL=redis://localhost:6379
